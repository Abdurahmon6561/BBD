<script>
    $(document).ready(function() {
        $.bvi({});
        wow = new WOW(
        {
            animateClass: 'animated',
            offset:       70,
            callback:     function(box) {
            console.log("WOW: animating <" + box.tagName.toLowerCase() + ">")
            }
        }
        );
        wow.init();
        /* defined by the standalone header script at the end of the page, so
           that a failure in any plugin above cannot take the header with it */
        function positionHeaderPanels() {
            if (window.positionHeaderPanels) window.positionHeaderPanels();
        }

        function closeHeaderPanels() {
            $('.js-search-content, .js-eye-content').slideUp(200);
            $('.js-search, .js-eye').removeClass('active');
        }

        positionHeaderPanels();
        $(window).on('scroll resize', positionHeaderPanels);

        $('.js-search').click(function (e) {
            e.stopPropagation();
            positionHeaderPanels();
            if ( $('.js-search-content').first().is( ":hidden" ) ) {
                $('.js-eye').removeClass('active')
                $(this).addClass('active')
                $('.js-eye-content').slideUp(300);
                $('.js-search-content').slideDown(300, function () {
                    $('.js-search-content .input').trigger('focus');
                });
            } else {
                $(this).removeClass('active')
                $('.js-search-content').slideUp(300);
            }
        });

        $('.js-eye').click(function (e) {
            e.stopPropagation();
            positionHeaderPanels();
            if ( $('.js-eye-content').first().is( ":hidden" ) ) {
                $('.js-search').removeClass('active')
                $(this).addClass('active')
                $('.js-search-content').slideUp(300);
                $('.js-eye-content').slideDown(300);
            } else {
                $(this).removeClass('active')
                $('.js-eye-content').slideUp(300);
            }
        });

        /* click outside or Esc closes the panels */
        $(document).on('click', function (e) {
            if ($(e.target).closest('.js-search-content, .js-eye-content, .js-search, .js-eye').length) return;
            closeHeaderPanels();
        });

        $(document).on('keydown', function (e) {
            if (e.key === 'Escape' || e.keyCode === 27) closeHeaderPanels();
        });

        $('.js-hamburger').click(function () {
            if ( $('.hamburger__content').first().is( ":hidden" ) ) {
                 $('.js-search-content').slideUp(300);
                 $('.js-eye-content').slideUp(300);
                 $('.js-search').removeClass('active')
                 $('.js-eye').removeClass('active')
                 $('body').addClass('o-hidden')
                 $('.hamburger__content').slideDown(300);
            } else {
                $('body').removeClass('o-hidden')
                $('.hamburger__content').slideUp(300);
            }
        });


        // Scroll down indicator
        $('.js-scroll-down').on('click', function() {
            $('html, body').animate({
                scrollTop: $('.main-about').offset().top - 20
            }, 800);
        });

    });
</script>

