<!-- Language switcher (UI only - no translation is performed) -->
<script>
    (function () {
        var sw = document.getElementById('langSwitcher');
        if (!sw) return;

        var btn     = sw.querySelector('.langswitch__btn');
        var flag    = btn.querySelector('.langswitch__flag');
        var code    = btn.querySelector('.langswitch__code');
        var options = sw.querySelectorAll('.langswitch__option');

        function close() {
            sw.classList.remove('is-open');
            btn.setAttribute('aria-expanded', 'false');
        }

        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var open = sw.classList.toggle('is-open');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });

        /* the menu also opens on hover, so a plain close() would be undone by
           the pointer still resting on the switcher */
        function dismiss() {
            close();
            sw.classList.add('is-dismissed');
        }

        sw.addEventListener('mouseleave', function () {
            sw.classList.remove('is-dismissed');
        });

        Array.prototype.forEach.call(options, function (opt) {
            opt.addEventListener('click', function (e) {
                e.stopPropagation();

                Array.prototype.forEach.call(options, function (o) {
                    o.classList.remove('is-active');
                    o.setAttribute('aria-selected', 'false');
                });

                opt.classList.add('is-active');
                opt.setAttribute('aria-selected', 'true');

                /* visual state only - nothing is translated here */
                flag.className = 'langswitch__flag flag-' + opt.getAttribute('data-lang');
                code.textContent = opt.getAttribute('data-code');

                dismiss();
            });
        });

        document.addEventListener('click', function (e) {
            if (!sw.contains(e.target)) close();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' || e.keyCode === 27) close();
        });
    })();
</script>


<!-- Sticky header + accessibility-mode guard.
     Deliberately standalone and jQuery-free: if any plugin above throws, the
     header must still pin itself. -->
<script>
    (function () {
        var topHeader  = document.getElementById('topHeader');
        var mainHeader = document.getElementById('mainHeader');
        if (!mainHeader) return;

        /* keep the search / eye panels glued to the bottom of the header */
        window.positionHeaderPanels = function () {
            var bottom = Math.max(0, mainHeader.getBoundingClientRect().bottom);
            var panels = document.querySelectorAll('.js-search-content, .js-eye-content');
            for (var i = 0; i < panels.length; i++) {
                panels[i].style.top = bottom + 'px';
            }
        };

        /* The header block scrolls away with the page. Once it has fully left
           the viewport the header returns as a floating bar, animated in and
           out, so pinning never reads as a jump. */
        var pinned = false;

        function pinPoint() {
            /* bottom edge of the header block in its resting position */
            if (mainHeader.className.indexOf('scrolled') !== -1) return pinPoint.cached || 164;
            pinPoint.cached = mainHeader.offsetTop + mainHeader.offsetHeight;
            return pinPoint.cached;
        }

        function update() {
            var y = window.pageYOffset || document.documentElement.scrollTop || 0;

            /* a dead band around the pin point stops the bar from flickering
               in and out while the user hovers around that scroll position */
            if (!pinned && y >= pinPoint() + 30) {
                pinned = true;
                mainHeader.classList.remove('is-leaving');
                mainHeader.classList.add('scrolled');
            } else if (pinned && y < pinPoint()) {
                pinned = false;
                mainHeader.classList.add('is-leaving');
            }

            window.positionHeaderPanels();
        }

        /* drop the fixed bar only once its exit animation has played out */
        mainHeader.addEventListener('animationend', function (e) {
            /* animationend bubbles - ignore anything a child animated */
            if (e.target !== mainHeader) return;

            if (mainHeader.classList.contains('is-leaving')) {
                mainHeader.classList.remove('is-leaving');
                mainHeader.classList.remove('scrolled');
            }
            window.positionHeaderPanels();
        });

        /* bvi puts a CSS filter on .bvi-body, which would trap the fixed
           header inside it. The stylesheet moves that filter up to <html>;
           this mirrors the attribute so it works without :has() too. */
        function mirrorBviColour() {
            var wrap = document.querySelector('.bvi-body');
            var mode = wrap ? wrap.getAttribute('data-bvi-color') : null;

            if (mode) {
                document.documentElement.setAttribute('data-bvi-color', mode);
            } else {
                document.documentElement.removeAttribute('data-bvi-color');
            }
        }

        function watchBvi() {
            var wrap = document.querySelector('.bvi-body');
            if (!wrap || !window.MutationObserver) return;

            new MutationObserver(mirrorBviColour).observe(wrap, {
                attributes: true,
                attributeFilter: ['data-bvi-color']
            });
        }

        function refresh() {
            update();
            mirrorBviColour();
            watchBvi();
        }

        update();
        mirrorBviColour();

        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        window.addEventListener('load', refresh);
        document.addEventListener('DOMContentLoaded', refresh);

        mainHeader.addEventListener('transitionend', function () {
            window.positionHeaderPanels();
        });
    })();
</script>

