<title>Birinchi Banklararo Depozitariy - РџРµСЂРІС‹Р№ РњРµР¶Р±Р°РЅРєРѕРІСЃРєРёР№ Р”РµРїРѕР·РёС‚Р°СЂРёР№</title>
<link rel="stylesheet" href="css/bvi.css" type="text/css">
<link rel="stylesheet" href="css/bvi-font.css" type="text/css">
<link href="https://fonts.googleapis.com/css?family=Montserrat:400,500,600,700,800&family=Space+Mono:400,700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/styles.min.css">
<link rel="stylesheet" href="css/modern-design.css">

    <style>
        /* =====================================================
           ROOT (from second.html)
        ===================================================== */
        :root {
            --primary: #263f87;
            --primary-dark: #17285f;
            --blue: #4e76e8;
            --white: #ffffff;
            --text: #172033;
            --gray: #667085;
            --top-bg: rgba(7, 16, 34, 0.82);
            --main-bg: rgba(7, 16, 34, 0.72);
            --border: rgba(255, 255, 255, 0.14);
        }

        /* =====================================================
           ICON FONT (icomoon) - from second.html
        ===================================================== */
        @font-face {
            font-family: 'icomoon';
            src: url('fonts/icomoon.eot');
            src: url('fonts/icomoon.eot#iefix') format('embedded-opentype'),
                 url('fonts/icomoon.ttf') format('truetype'),
                 url('fonts/icomoon.woff') format('woff'),
                 url('images/icomoon.svg#icomoon') format('svg');
            font-weight: normal;
            font-style: normal;
            font-display: block;
        }

        [class^="icon-"], [class*=" icon-"] {
            font-family: 'icomoon' !important;
            speak: none;
            font-style: normal;
            font-weight: normal;
            font-variant: normal;
            text-transform: none;
            line-height: 1;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .icon-facebook:before { content: "\e904"; }
        .icon-in:before { content: "\e905"; }
        .icon-instagram:before { content: "\e906"; }
        .icon-telegram:before { content: "\e90c"; }
        .icon-search:before { content: "\e90a"; }
        .icon-eye:before { content: "\e902"; }

        /* =====================================================
           CONTAINER - from second.html
        ===================================================== */
        .container {
            width: min(1440px, calc(100% - 80px));
            margin: 0 auto;
        }

        /* =====================================================
           TOP HEADER - from second.html
        ===================================================== */
        .top-header {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 62px;
            z-index: 100;
            color: white;
            background: var(--top-bg);
            border-top: 1px solid rgba(255,255,255,.10);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(14px);
            transition: .3s ease;
        }

        .top-header-inner {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .top-socials {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .top-social {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255,255,255,.42);
            border-radius: 50%;
            color: white;
            font-size: 16px;
            font-weight: normal;
            transition: .25s ease;
        }

        .top-social:hover {
            background: white;
            color: var(--primary);
            transform: translateY(-2px);
        }

        .top-tools {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .top-tools button {
            border: none;
            background: transparent;
            padding: 0;
            cursor: pointer;
        }

        .search-icon {
            font-size: 18px;
            color: white;
            cursor: pointer;
            opacity: .9;
            transition: .25s ease;
        }

        .search-icon:hover {
            transform: scale(1.1);
            opacity: 1;
        }

        .eye-icon {
            font-size: 20px;
            color: white;
            cursor: pointer;
            opacity: .9;
            transition: .25s ease;
        }

        .eye-icon:hover {
            transform: scale(1.1);
            opacity: 1;
        }

        /* =====================================================
           MAIN HEADER - from second.html
        ===================================================== */
        .main-header {
            position: absolute;
            top: 62px;
            left: 0;
            width: 100%;
            height: 102px;
            z-index: 100;
            color: white;
            background: var(--main-bg);
            border-bottom: 1px solid rgba(255,255,255,.10);
            backdrop-filter: blur(12px);
            transition: .3s ease;
        }

        .main-header-inner {
            height: 100%;
            display: flex;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .logo-icon {
            width: 61px;
            height: 61px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1.5px solid rgba(255,255,255,.85);
        }

        .logo-icon::before {
            content: "";
            width: 26px;
            height: 36px;
            background: white;
            border-radius: 1px 16px 16px 1px;
        }

        .logo-icon::after {
            content: "";
            position: absolute;
            width: 27px;
            height: 36px;
            left: 12px;
            background: rgba(255,255,255,.85);
            clip-path: polygon(
                0 0,
                55% 0,
                55% 100%,
                0 100%
            );
        }

        .logo-text {
            font-size: 17px;
            line-height: 1.08;
            font-weight: 600;
            white-space: nowrap;
        }

        .logo-text span {
            display: block;
        }

        .main-nav {
            display: flex;
            align-items: center;
            gap: 31px;
            margin-left: auto;
            margin-right: auto;
        }

        .main-nav a {
            position: relative;
            color: rgba(255,255,255,.84);
            font-size: 15px;
            font-weight: 600;
            white-space: nowrap;
            transition: .25s ease;
        }

        .main-nav a:hover {
            color: white;
        }

        .main-nav a::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: -13px;
            width: 0;
            height: 2px;
            background: white;
            transition: .25s ease;
        }

        .main-nav a:hover::after {
            width: 100%;
        }

        .nav-item {
            position: relative;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav-caret {
            width: 6px;
            height: 6px;
            flex-shrink: 0;
            margin-top: -3px;
            border-right: 1.5px solid currentColor;
            border-bottom: 1.5px solid currentColor;
            transform: rotate(45deg);
            transition: transform 0.25s ease;
        }

        .nav-item:hover .nav-link .nav-caret {
            transform: rotate(225deg);
        }

        .dropdown-menu {
            position: absolute;
            top: 100%;
            left: 0;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 12px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            border: 1px solid rgba(0, 0, 0, 0.06);
            padding: 12px 0;
            min-width: 240px;
            opacity: 0;
            visibility: hidden;
            transform: translateY(15px) scale(0.95);
            transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            z-index: 100;
        }

        .nav-item:hover .dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .dropdown-menu::after {
            content: "";
            position: absolute;
            top: -6px;
            left: 20px;
            width: 12px;
            height: 12px;
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(0, 0, 0, 0.06);
            transform: rotate(45deg);
        }

        .dropdown-menu a {
            display: block;
            padding: 10px 20px;
            color: var(--primary);
            font-size: 14px;
            font-weight: 400;
            transition: all 0.25s ease;
            white-space: nowrap;
            border-bottom: 1px solid rgba(39, 59, 137, 0.05);
        }

        .dropdown-menu a:last-child {
            border-bottom: none;
        }

        .dropdown-menu a:hover {
            background: linear-gradient(90deg, rgba(39, 59, 137, 0.05), rgba(0, 162, 224, 0.05));
            color: #00a2e0;
            padding-left: 25px;
        }

        .dropdown-menu a::after {
            content: none;
        }

        .language {
            display: flex;
            align-items: center;
            gap: 8px;
            height: 42px;
            padding: 0 16px;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.20);
            border-radius: 8px;
            color: white;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: .25s ease;
        }

        .language:hover {
            background: rgba(255,255,255,.20);
        }

        .flag {
            width: 24px;
            height: 24px;
            border-radius: 2px;
            background: url("images/ru-flag.svg") center/contain no-repeat;
        }

        /* =====================================================
           HERO SLIDER - from second.html
        ===================================================== */
        .hero-slider {
            height: 100vh;
            min-height: 720px;
            overflow: hidden;
            background: #101010;
        }

        .slides {
            width: 100%;
            height: 100%;
            position: relative;
        }

        .slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            visibility: hidden;
            transform: scale(1.04);
            transition:
                opacity .8s ease,
                transform 1.2s ease,
                visibility .8s ease;
            background-size: cover;
            background-position: center;
        }

        .slide.active {
            opacity: 1;
            visibility: visible;
            transform: scale(1);
        }

        .slide:nth-child(1) {
            background-image:
                linear-gradient(
                    90deg,
                    rgba(5,15,35,.82) 0%,
                    rgba(5,15,35,.50) 48%,
                    rgba(5,15,35,.22) 100%
                ),
                url("images/1590128317.jpg");
        }

        .slide:nth-child(2) {
            background-image:
                linear-gradient(
                    90deg,
                    rgba(5,15,35,.82) 0%,
                    rgba(5,15,35,.48) 50%,
                    rgba(5,15,35,.20) 100%
                ),
                url("images/main-image.png");
        }

        .slide:nth-child(3) {
            background-image:
                linear-gradient(
                    90deg,
                    rgba(5,15,35,.82) 0%,
                    rgba(5,15,35,.50) 50%,
                    rgba(5,15,35,.20) 100%
                ),
                url("images/1590126345.jpg");
        }

        .slide-content {
            width: min(1440px, calc(100% - 80px));
            height: 100%;
            margin: auto;
            display: flex;
            align-items: center;
            padding-top: 155px;
            color: white;
        }

        .hero-text {
            max-width: 680px;
        }

        .hero-title {
            font-size: clamp(46px, 4.3vw, 70px);
            line-height: 1.08;
            letter-spacing: -2px;
            font-weight: 800;
            margin-bottom: 22px;
        }

        .hero-description {
            max-width: 620px;
            font-size: clamp(16px, 1.3vw, 21px);
            line-height: 1.45;
            color: rgba(255,255,255,.84);
            font-weight: 500;
        }

        .slider-controls {
            position: absolute;
            z-index: 20;
            bottom: 42px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .dot {
            width: 12px;
            height: 12px;
            padding: 0;
            border: 1px solid white;
            border-radius: 50%;
            background: transparent;
            cursor: pointer;
            transition: .3s ease;
        }

        .dot.active {
            background: white;
            transform: scale(1.15);
        }

        .slider-arrow {
            position: absolute;
            z-index: 20;
            top: 50%;
            transform: translateY(-50%);
            width: 52px;
            height: 52px;
            border: 1px solid rgba(255,255,255,.35);
            border-radius: 50%;
            background: rgba(0,0,0,.15);
            backdrop-filter: blur(10px);
            color: white;
            font-size: 28px;
            cursor: pointer;
            opacity: 0;
            transition: .3s ease;
        }

        .hero-slider:hover .slider-arrow {
            opacity: 1;
        }

        .slider-arrow:hover {
            background: white;
            color: var(--primary);
        }

        .prev {
            left: 35px;
        }

        .next {
            right: 35px;
        }

        .slide-counter {
            position: absolute;
            z-index: 20;
            bottom: 38px;
            right: 45px;
            color: white;
            font-size: 14px;
            font-weight: 600;
        }

        .current-slide {
            font-size: 20px;
        }

        .total-slides {
            opacity: .55;
        }

        /* =====================================================
           SCROLLED HEADER - from second.html
        ===================================================== */
        .top-header.scrolled {
            position: fixed;
            height: 54px;
            background: rgba(12,25,55,.97);
            backdrop-filter: blur(18px);
            box-shadow:
                0 8px 30px rgba(0,0,0,.16);
        }

        .main-header.scrolled {
            position: fixed;
            top: 54px;
            height: 76px;
            background: rgba(23,40,95,.97);
            backdrop-filter: blur(18px);
            box-shadow:
                0 10px 30px rgba(0,0,0,.15);
        }

        .main-header.scrolled .logo-icon {
            width: 52px;
            height: 52px;
        }

        /* =====================================================
           RESPONSIVE - from second.html
        ===================================================== */
        @media (max-width: 1150px) {
            .container {
                width: min(100% - 50px, 1440px);
            }
            .main-nav {
                gap: 18px;
            }
            .main-nav a {
                font-size: 13px;
            }
            .logo-text {
                font-size: 14px;
            }
            .logo-icon {
                width: 54px;
                height: 54px;
            }
        }

        @media (max-width: 900px) {
            .container {
                width: min(100% - 40px, 1440px);
            }
            .main-nav {
                gap: 12px;
            }
            .main-nav a {
                font-size: 12px;
            }
            .logo-text {
                display: none;
            }
            .logo-icon {
                width: 50px;
                height: 50px;
            }
            .hero-title {
                font-size: 48px;
            }
            .hero-description {
                font-size: 16px;
            }
            .slider-arrow {
                display: none;
            }
        }

        @media (max-width: 700px) {
            .container {
                width: calc(100% - 30px);
            }
            .top-header {
                height: 54px;
            }
            .top-social {
                width: 32px;
                height: 32px;
                font-size: 11px;
            }
            .top-tools {
                gap: 15px;
            }
            .main-header {
                top: 54px;
                height: 82px;
            }
            .main-nav {
                display: none;
            }
            .main-header-inner {
                justify-content: space-between;
            }
            .logo-text {
                display: block;
                font-size: 13px;
            }
            .logo-icon {
                width: 48px;
                height: 48px;
            }
            .language {
                height: 38px;
            }
            .hero-slider {
                min-height: 680px;
            }
            .slide-content {
                width: calc(100% - 30px);
                padding-top: 120px;
            }
            .hero-title {
                font-size: 38px;
                letter-spacing: -1px;
            }
            .hero-description {
                font-size: 15px;
            }
            .slide-counter {
                display: none;
            }
        }

        @media (max-width: 450px) {
            .top-socials {
                gap: 5px;
            }
            .top-social {
                width: 29px;
                height: 29px;
            }
            .logo-text {
                font-size: 11px;
            }
            .flag {
                width: 18px;
                height: 18px;
            }
            .language {
                font-size: 12px;
                padding: 0 8px;
            }
            .hero-title {
                font-size: 34px;
            }
        }
    </style>
</head>
<body>
   
<!-- =====================================================
     TOP HEADER

     LEFT:
     Facebook / LinkedIn / Telegram / Instagram

     RIGHT:
     Search / Eye
===================================================== -->

<div class="top-header" id="topHeader">

    <div class="container top-header-inner">


        <!-- SOCIAL MEDIA - LEFT -->

        <div class="top-socials">

            <a href="#" class="top-social">
                <i class="icon-facebook"></i>
            </a>

            <a href="#" class="top-social">
                <i class="icon-in"></i>
            </a>

            <a href="#" class="top-social">
                <i class="icon-telegram"></i>
            </a>

            <a href="#" class="top-social">
                <i class="icon-instagram"></i>
            </a>

        </div>


        <!-- SEARCH + EYE - RIGHT -->

        <div class="top-tools">

            <button
                class="header__search js-search search-icon"
                aria-label="Поиск"
            >
                <i class="icon-search"></i>
            </button>

            <button
                class="header__eye js-eye eye-icon"
                aria-label="Версия для слабовидящих"
            >
                <i class="icon-eye"></i>
            </button>

        </div>

    </div>

</div>

<!-- Search Panel -->
<div class="js-search-content d-none">
    <div class="header__search-content">
        <div class="container">
            <div class="d-flex align-items-center">
                <input type="text" class="input" placeholder="Поиск">
                <button>
                    <i class="icon-search"></i>
                </button>
           </div>
        </div>
    </div>
</div>

<!-- Eye/Accessibility Panel -->
<div class="js-eye-content d-none">
    <div class="header__eye-content">
        <div class="container full-height">
            <div class="d-flex align-items-center justify-content-center flex-wrap-md full-height">
                <div class="d-flex align-items-center mr-45">
                    <p class="mr-10">Звук:</p>
                    <button class="header__eye-content_radio js-voice active">
                        <i class="icon-radio"></i>
                    </button>
                </div>
                <div class="d-flex align-items-center mr-45">
                    <p class="mr-10">Шрифт:</p>
                    <button class="header__eye-content_button js-font-size-decrease">
                        <i class="icon-minus"></i>
                    </button>
                    <button class="header__eye-content_button js-font-size-increase">
                        <i class="icon-plus"></i>
                    </button>
                </div>
                <div class="d-flex align-items-center mr-45">
                    <p class="mr-10">Вид сайта:</p>
                    <div class="d-flex align-items-center">
                        <p class="header__eye-content_color bvi-color bg-blue-light">A</p>
                        <p class="header__eye-content_color bvi-color bg-silver" data-color="blackAndWhite">A</p>
                        <p class="header__eye-content_color bvi-color" data-color="blackAndWhiteInvert">A</p>
                    </div>
                </div>
                <button class="btn btn--white js-settings-default">Сбросить настройки</button>
            </div>
        </div>
    </div>
</div>


<!-- =====================================================
     MAIN HEADER

     LEFT:
     LOGO

     CENTER:
     NAVIGATION

     RIGHT:
     RU
===================================================== -->

<header
    class="main-header"
    id="mainHeader"
>

    <div class="container main-header-inner">


        <!-- LOGO -->

